# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>/meal_management
MONGODB_URI=mongodb://127.0.0.1:27017/meal_management
# Long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins. Capacitor apps use capacitor://localhost and http://localhost
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
# Public URL of the web app, used in password reset links
APP_URL=http://localhost:5173
# Max upload size for receipts/photos in MB
UPLOAD_MAX_MB=3
# API requests per minute per IP (members of one mess often share an IP)
RATE_LIMIT_PER_MIN=1000
